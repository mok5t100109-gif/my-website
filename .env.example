# Slack Bot Configuration
# Copy this file to .env and fill in the values

# Bot Token (xoxb-...) obtained from:
# api.slack.com/apps → OAuth & Permissions → Bot OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# Signing Secret obtained from:
# api.slack.com/apps → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-Level Token (xapp-...) for Socket Mode, obtained from:
# api.slack.com/apps → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token-here

# Port for the bot server (default: 3000)
PORT=3000
